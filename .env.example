# Copy this file to .env and fill in the three required values.
# Never commit .env. This bot talks in Telegram voice notes, not live calls.

# Required. From @BotFather.
TELEGRAM_BOT_TOKEN=

# Required. From https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required. Your numeric Telegram user id (ask @userinfobot).
OWNER_TELEGRAM_ID=

# Chat Completions model used for both text and voice replies.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=500
OPENAI_TIMEOUT=60

# Speech-to-text for incoming voice notes. Alternatives: gpt-4o-transcribe, whisper-1.
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# Language hint. Use ar for Iraqi Arabic. Leave empty to auto-detect.
STT_LANGUAGE=ar
# Optional hint for names or vocabulary. Leave empty to skip.
STT_PROMPT=

# Text-to-speech. opus is sent as a Telegram voice note. mp3 is sent as an audio file.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_FORMAT=opus
# Used only by gpt-4o* TTS models. Leave empty to skip style instructions.
TTS_INSTRUCTIONS=Speak in a warm, natural Iraqi Arabic conversational tone. Sound like a friendly person from Baghdad: clear, unhurried, and informal.

# Optional. If set, this replaces config/persona.md until the owner sends /persona.
# The owner's /persona command overrides both this value and the file.
# SYSTEM_PROMPT=

# Behavior
ALLOW_GROUPS=false
ALWAYS_VOICE=false
HISTORY_LIMIT=20
DATABASE_PATH=data/bot.db
PERSONA_PATH=config/persona.md
LOG_LEVEL=INFO
